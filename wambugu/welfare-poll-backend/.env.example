# ============================================
# WELFARE POLL - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and update with your values
# For production: Use strong, unique secrets!

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
API_URL=https://your-backend.vercel.app

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For Supabase (Recommended for Production):
# Get these from: Supabase Dashboard → Settings → Database
# IMPORTANT: Use Connection Pooling (port 6543) for production!

# Full connection string (for Vercel/Production)
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Individual credentials (optional, for local development)
DB_HOST=db.xxxxx.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_supabase_password

# For Local Development with Docker:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=welfare_poll
# DB_USER=postgres
# DB_PASSWORD=postgres

# ============================================
# JWT AUTHENTICATION
# ============================================
# CRITICAL: Generate new secrets for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_IN_PRODUCTION
JWT_EXPIRE=7d

# ============================================
# SECURITY
# ============================================
# Vote hash secret (must be unique and different from JWT_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VOTE_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_32_CHAR_STRING

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Email can be disabled for development/testing
# Set EMAIL_ENABLED=false to disable email sending

EMAIL_ENABLED=false

# For Gmail (when enabling email):
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Generate App Password at https://myaccount.google.com/apppasswords
# 4. Use the 16-character app password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=noreply@welfare-poll.com

# To disable email in development:
# EMAIL_ENABLED=false
# SMTP_USER=disabled
# SMTP_PASS=disabled

# ============================================
# CORS & FRONTEND
# ============================================
# Production: Set to your exact frontend URL (no trailing slash)
# Development: http://localhost:3000
CORS_ORIGIN=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ============================================
# RATE LIMITING
# ============================================
# Window in minutes
RATE_LIMIT_WINDOW=15
# Max requests per window
RATE_LIMIT_MAX=100

# ============================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================
#
# Vercel Deployment:
# 1. Add all variables in Vercel Dashboard → Settings → Environment Variables
# 2. Use DATABASE_URL for Supabase connection
# 3. Generate new JWT_SECRET and VOTE_SECRET
# 4. Update CORS_ORIGIN after frontend deployment
# 5. Enable email after deployment (optional)
#
# Security Checklist:
# ✓ Change JWT_SECRET from example value
# ✓ Change VOTE_SECRET from example value
# ✓ Use strong database password
# ✓ Set CORS_ORIGIN to exact frontend URL
# ✓ Enable EMAIL_ENABLED only when SMTP is configured
# ✓ Never commit .env file to git
#
# Quick Setup:
# Development: Copy to .env and use localhost values
# Production: Use Vercel environment variables with production values
#
# See deployment guides:
# - DEPLOY_NOW.md for step-by-step instructions
# - READY_TO_DEPLOY.md for checklist
