# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Use this template for Vercel deployment
# Add these variables in Vercel Dashboard → Settings → Environment Variables

# ============================================
# SERVER
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# DATABASE (Supabase)
# ============================================
# Get from: Supabase Dashboard → Settings → Database → Connection String
# IMPORTANT: Use connection pooling URL (port 6543)!
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

DB_HOST=db.xxxxx.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[YOUR-SUPABASE-PASSWORD]

# ============================================
# SECURITY - CRITICAL: CHANGE THESE!
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=[GENERATE-RANDOM-32-CHAR-STRING]
JWT_EXPIRE=7d
VOTE_SECRET=[GENERATE-DIFFERENT-RANDOM-32-CHAR-STRING]

# ============================================
# EMAIL (Optional - can enable later)
# ============================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=disabled
SMTP_PASS=disabled
SMTP_FROM=noreply@welfare-poll.com

# To enable email:
# 1. Get Gmail App Password: https://myaccount.google.com/apppasswords
# 2. Set EMAIL_ENABLED=true
# 3. Set SMTP_USER=your-email@gmail.com
# 4. Set SMTP_PASS=your-16-char-app-password

# ============================================
# CORS & FRONTEND
# ============================================
# Update after frontend deployment!
CORS_ORIGIN=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
# Before deploying:
# [ ] Generate new JWT_SECRET (don't use example value!)
# [ ] Generate new VOTE_SECRET (don't use example value!)
# [ ] Update DATABASE_URL with Supabase connection string
# [ ] Update DB_PASSWORD with Supabase password
# [ ] Set CORS_ORIGIN to your frontend URL (after frontend deploys)
# [ ] Set FRONTEND_URL to your frontend URL
# [ ] Decide if enabling email (can do later)
#
# After deploying:
# [ ] Test health endpoint: https://your-backend.vercel.app/health
# [ ] Update CORS_ORIGIN to actual frontend URL
# [ ] Redeploy backend after CORS update
# [ ] Verify admin login works
# [ ] Change admin password from default
